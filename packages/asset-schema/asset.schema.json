{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alagarda.local/schemas/asset.schema.json",
  "title": "ALAGARDA Asset",
  "description": "Metadatos de un activo 3D de la biblioteca. Contrato compartido entre la web, el escritorio y el motor local.",
  "type": "object",
  "required": ["id", "name", "project", "category", "tags", "license", "provenance", "version", "sizeBytes", "createdAt", "updatedAt"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string", "minLength": 1 },
    "project": { "type": "string" },
    "category": {
      "enum": ["toro", "torero", "caballo", "capote-muleta", "publico", "plaza", "humano", "animal", "vehiculo", "ropa", "edificio", "escenario", "objeto", "otro"]
    },
    "tags": { "type": "array", "items": { "type": "string" } },
    "license": { "type": "string" },
    "provenance": {
      "type": "object",
      "required": ["source", "engine", "originalFileName", "parentId"],
      "properties": {
        "source": { "enum": ["import", "generated", "export"] },
        "engine": { "type": ["string", "null"] },
        "originalFileName": { "type": ["string", "null"] },
        "parentId": { "type": ["string", "null"] }
      }
    },
    "version": { "type": "integer", "minimum": 1 },
    "sizeBytes": { "type": "integer", "minimum": 0 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "thumbnail": { "type": ["string", "null"] },
    "stats": { "type": ["object", "null"] }
  }
}
