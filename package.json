{
  "name": "alagarda-3d-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Estudio de creación 3D asistido por IA con exportación GLB (glTF 2.0).",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @alagarda/web dev",
    "build": "pnpm --filter @alagarda/web build",
    "test": "pnpm --filter @alagarda/web test",
    "typecheck": "pnpm -r typecheck",
    "api": "python -m uvicorn services.api.main:app --reload --host 127.0.0.1 --port 8000",
    "test:api": "python -m pytest tests -q",
    "diagnose": "python -m services.generation.external.huggingface.diagnose"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
