# Copia este archivo como .env y ajusta los valores. Nunca subas .env a GitHub.

# --- Motor local (services/api) ---
ALAGARDA_API_HOST=127.0.0.1
ALAGARDA_API_PORT=8000
# Orígenes permitidos para la interfaz web (separados por comas)
ALAGARDA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Carpeta local donde se guardan generaciones y exportaciones
ALAGARDA_STORAGE_DIR=./storage

# --- TRELLIS (Fase 2) ---
# Ruta a una instalación local de TRELLIS (repositorio clonado + entorno)
TRELLIS_PATH=

# --- Hunyuan3D (experimental, pendiente de revisión de licencia) ---
HUNYUAN_PATH=

# --- Tripo (proveedor externo opcional, DESACTIVADO por defecto) ---
TRIPO_ENABLED=false
TRIPO_API_KEY=
# Límite de gasto en créditos por sesión del motor
TRIPO_MAX_CREDITS_PER_SESSION=0
